# Maintainer: gzleo

pkgname=sqlitebrowser-qt4
pkgver=3.9.1
pkgrel=1
pkgdesc="Light GUI editor for SQLite databases, built on top of Qt4"
arch=('x86_64')
url="https://sqlitebrowser.org"
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'qt4' 'sqlite' 'hicolor-icon-theme')
makedepends=('cmake')
source=("https://github.com/sqlitebrowser/sqlitebrowser/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('d0d2e06a69927ba1d0b955f3261ce70c61befc5bd5ddaa06752dae8bb4219ed8')
options=(!lto)

prepare() {
  cd "sqlitebrowser-$pkgver"
  # 上游 target 名是 "DB Browser for SQLite"（带空格），改成合法文件名
  sed -i 's|DB Browser for SQLite|sqlitebrowser|g' CMakeLists.txt
}

build() {
  cd "sqlitebrowser-$pkgver"
  cmake -B build -S . \
    -DUSE_QT5=FALSE \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_STANDARD=11 \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DQT_QMAKE_EXECUTABLE=/usr/bin/qmake-qt4 \
    -Wno-dev
  cmake --build build -j"$(nproc)"
}

package() {
  cd "sqlitebrowser-$pkgver"
  DESTDIR="$pkgdir" cmake --install build

  # 与官方 sqlitebrowser(Qt5) 共存：程序/桌面文件/图标全部改名
  mv "$pkgdir/usr/bin/sqlitebrowser" "$pkgdir/usr/bin/sqlitebrowser-qt4"
  mv "$pkgdir/usr/share/applications/sqlitebrowser.desktop" \
     "$pkgdir/usr/share/applications/sqlitebrowser-qt4.desktop"
  sed -i \
    -e 's/^Name=DB Browser for SQLite$/Name=DB Browser for SQLite (Qt4)/' \
    -e 's/^Exec=sqlitebrowser %f$/Exec=sqlitebrowser-qt4 %f/' \
    -e 's/^Icon=sqlitebrowser$/Icon=sqlitebrowser-qt4/' \
    "$pkgdir/usr/share/applications/sqlitebrowser-qt4.desktop"

  mv "$pkgdir/usr/share/icons/hicolor/256x256/apps/sqlitebrowser.png" \
     "$pkgdir/usr/share/icons/hicolor/256x256/apps/sqlitebrowser-qt4.png"
  install -Dm644 images/sqlitebrowser.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/sqlitebrowser-qt4.svg"

  # 旧式 appdata 目录 -> metainfo，并改 id 避免和官方包重复
  install -d "$pkgdir/usr/share/metainfo"
  sed 's|<id>sqlitebrowser.desktop</id>|<id>sqlitebrowser-qt4.desktop</id>|' \
    "$pkgdir/usr/share/appdata/sqlitebrowser.desktop.appdata.xml" \
    > "$pkgdir/usr/share/metainfo/sqlitebrowser-qt4.appdata.xml"
  rm -rf "$pkgdir/usr/share/appdata"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
