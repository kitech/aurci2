# Vox Browser — browser engine written in V (JavaScriptCore + V UI2)

pkgname=vox-git
pkgver=0.1.3
pkgrel=8
pkgdesc='Browser engine written in V (JavaScriptCore + V UI2)'
arch=('x86_64')
url='https://vox-browser.org'
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'glib2' 'harfbuzz' 'fontconfig' 'freetype2'
         'curl' 'openssl' 'mesa' 'libxi' 'libxcursor' 'libxrandr' 'libx11'
         'alsa-lib' 'gc' 'libwebp' 'libpng' 'libjpeg-turbo')
makedepends=('clang' 'pkgconf' 'git' 'python')
provides=('vox')
conflicts=('vox')

# 全部跟随上游 HEAD，不固定 git commit；pkgver 仍由 vox 的 git describe 生成。
# GNUmakefile 会自行拉取与 V 匹配的 vc/tcc 快照。
source=("vox::git+https://github.com/vox-browser/vox.git"
        "v::git+https://github.com/vlang/v.git"
        "ui2::git+https://github.com/vlang/ui2.git")
sha256sums=('SKIP' 'SKIP' 'SKIP')

pkgver() {
  cd vox
  git describe --long --tags --abbrev=8 | sed 's/^v//; s/\([^-]*-g\)/r\1/; s/-/./g'
}

prepare() {
  # 构建产物统一放 Build/，确保从干净状态开始
  rm -rf vox/Build
}

build() {
  # 显式 -cc clang：V 不会进入 implicit tcc 分支，避免
  # "tcc: error: unsupported linker option '-O1'" 后回退到 /usr/bin/cc。
  # VFLAGS 会被合并进所有 V 调用（含 build-linux-browser.sh 内部的 v_tool）。
  export VFLAGS='-cc clang'
  export CC=clang

  make -C v -j2 CC=clang VFLAGS='-cc clang -memory-limit 10G'

  cd vox
  export V_BIN="$srcdir/v/v"
  export UI2_SOURCE_DIR="$srcdir/ui2"
  export CC=clang
  export LADYBIRD_V_GC=boehm        # 发行版线程版 Boehm GC
  export VOX_BUILD_V_PROD=1         # 等价 -prod
  export VOX_BUILD_SUPERVISED=1     # 跳过 supervisor，直调 build-linux-browser.sh
  export VOX_LINUX_CFLAGS="-O2"

  sh build-linux-browser.sh         # 产出 Build/linux/vox
}

check() {
  cd vox
  timeout 300 ./Build/linux/vox --headless-smoke
}

package() {
  cd vox
  install -Dm755 Build/linux/vox "$pkgdir/usr/bin/vox"
  install -Dm644 packaging/Vox.png "$pkgdir/usr/share/pixmaps/vox.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/vox.desktop" <<'EOF'
[Desktop Entry]
Name=Vox Browser
Comment=Browser engine written in V
Exec=vox %u
Icon=vox
Terminal=false
Type=Application
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
EOF
}
